<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/vd_nfc_splash_base">

    <!-- Wave 1 Animation - Outer NFC wave -->
    <target android:name="wave_1_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:interpolator/fast_out_linear_in"
                android:propertyName="trimPathEnd"
                android:startOffset="200"
                android:valueFrom="0"
                android:valueTo="1"
                android:repeatCount="infinite"
                android:repeatMode="restart"/>
        </aapt:attr>
    </target>

    <!-- Wave 2 Animation - Inner NFC wave -->
    <target android:name="wave_2_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="800"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="500"
                android:valueFrom="0"
                android:valueTo="1"
                android:repeatCount="infinite"
                android:repeatMode="restart"/>
        </aapt:attr>
    </target>

    <!-- Center Dot Animation -->
    <target android:name="center_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="800"
                android:valueFrom="0"
                android:valueTo="1"
                android:repeatCount="infinite"
                android:repeatMode="restart"/>
        </aapt:attr>
    </target>

    <!-- Outer wave pulse effect -->
    <target android:name="nfc_base">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1500"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="scaleX"
                android:valueFrom="0.8"
                android:valueTo="1.1"
                android:repeatCount="infinite"
                android:repeatMode="reverse"/>
        </aapt:attr>
    </target>

</animated-vector>
