<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules for NFC Manager (Android 12+)
    Defines which data can be extracted for backup and transfer
    
    Security Note:
    - NFC tag data is private and not backed up
    - Activity logs are private and not backed up
    - Only non-sensitive settings are backed up
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include only non-sensitive preferences -->
        <include domain="sharedpref" path="." />
        
        <!-- Exclude all sensitive data -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    
    <device-transfer>
        <!-- Allow transfer of user preferences only -->
        <include domain="sharedpref" path="." />
        
        <!-- Exclude sensitive data from device transfer -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
