<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup Rules for NFC Manager
    Defines which data should be backed up to Google Drive
    
    Security Note:
    - Sensitive NFC data is excluded from backup
    - Only user preferences are backed up
-->
<full-backup-content>
    <!-- Include user preferences -->
    <include domain="sharedpref" path="." />
    
    <!-- Exclude sensitive data -->
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
