    <string name="about_title">Acerca de</string>
    <string name="about_app_title">Acerca de NFC Manager</string>
    <string name="about_app_description">NFC Manager es una aplicación de Android centrada en la privacidad diseñada para ayudar a los usuarios a monitorear y gestionar sus ajustes de NFC (Near Field Communication) con una mayor conciencia de seguridad. La aplicación alerta a los usuarios cuando NFC permanece activado por períodos prolongados, ayudando a prevenir accesos no autorizados y protegiendo contra posibles vulnerabilidades de privacidad.</string>
